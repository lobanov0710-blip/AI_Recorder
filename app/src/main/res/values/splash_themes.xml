<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style
        name="Theme.AIRecorder.Starting"
        parent="Theme.SplashScreen.IconBackground">

        <!-- Main splash background -->

        <item name="windowSplashScreenBackground">
            @color/ic_launcher_background
        </item>

        <!--
            Android 7-11:
            res/drawable/splash_icon.xml

            Android 12+:
            res/drawable-v31/splash_icon.xml
        -->

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/splash_icon
        </item>

        <!-- Background directly underneath the icon -->

        <item name="windowSplashScreenIconBackgroundColor">
            @color/ic_launcher_background
        </item>

        <!--
            Required on Android 12 / API 31-32.
            Android 13+ infers AVD duration itself.
        -->

        <item name="windowSplashScreenAnimationDuration">
            420
        </item>

        <!-- Main application theme -->

        <item name="postSplashScreenTheme">
            @style/Theme.AIRecorder
        </item>

    </style>

</resources>