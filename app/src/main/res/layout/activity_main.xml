<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- HEADER -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/ai_text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/records_subtitle"
        android:textColor="@color/ai_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/records_title"
        android:textColor="@color/ai_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- RECORDINGS -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <!-- RECORDINGS -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRecords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="12dp" />

        <!-- EMPTY STATE -->

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_empty_icon"
                android:contentDescription="@null"
                android:padding="22dp"
                app:srcCompat="@drawable/ic_mic_24"
                app:tint="@color/ai_primary_light" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/empty_records_title"
                android:textColor="@color/ai_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/empty_records_description"
                android:textColor="@color/ai_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- RECORDING PANEL -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/ai_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/ai_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <!-- STATE -->

            <TextView
                android:id="@+id/txtRecordingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/record_in_progress"
                android:textColor="@color/ai_record"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- TIMER -->

            <TextView
                android:id="@+id/txtRecordTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/time_zero"
                android:textColor="@color/ai_text_primary"
                android:textSize="40sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- WAVEFORM -->

            <com.nicko.airecorder.view.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />

            <!-- CONTROLS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- MAIN ACTION -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnRecord"
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:background="@drawable/bg_record_idle"
                        android:contentDescription="@string/record_start"
                        android:padding="25dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_mic_24" />

                    <TextView
                        android:id="@+id/txtRecordAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/record_start"
                        android:textColor="@color/ai_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- STOP -->

                <LinearLayout
                    android:id="@+id/stopContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnStop"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:background="@drawable/bg_record_stop"
                        android:contentDescription="@string/record_stop"
                        android:padding="19dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_stop_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/record_stop"
                        android:textColor="@color/ai_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>