<?xml version="1.0" encoding="utf-8"?>

<data-extraction-rules>

    <!--
        Cloud backup intentionally disabled
        for recordings and local database.
    -->
    <cloud-backup>

        <exclude
            domain="file"
            path="." />

        <exclude
            domain="database"
            path="." />

        <exclude
            domain="sharedpref"
            path="." />

        <exclude
            domain="root"
            path="." />

        <exclude
            domain="external"
            path="." />

    </cloud-backup>

    <!--
        Device-to-device migration:
        recordings and Room database move together.
    -->
    <device-transfer>

        <include
            domain="file"
            path="." />

        <include
            domain="database"
            path="." />

    </device-transfer>

</data-extraction-rules>